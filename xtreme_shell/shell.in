#!/usr/bin/env python3
import sys
import os


PKG_DATA_DIR = "@pkgdatadir@"
VERSION = "@VERSION@"

sys.path.insert(1, PKG_DATA_DIR)

from gi.repository import Gio

resource = Gio.Resource.load(
    os.path.join(PKG_DATA_DIR, "xtreme_shell", "xtreme-shell.gresource")
)
resource._register()

from xtreme_shell.main import run

if __name__ == "__main__":
    run(sys.argv[1:])
